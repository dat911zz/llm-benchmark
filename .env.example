# LLM Benchmark Configuration
# Copy this file to .env and fill in your actual values
# The .env file will be ignored by git (see .gitignore)

# API Endpoint (OpenAI-compatible)
# Examples:
#   - LM Studio: http://localhost:1234/v1
#   - Ollama: http://localhost:11434/v1
#   - OpenAI: https://api.openai.com/v1
#   - Dashscope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=http://localhost:1234/v1

# API Key (leave empty for local models like LM Studio/Ollama)
# Examples:
#   - OpenAI: sk-proj-...
#   - Dashscope: sk-...
#   - Local (no auth): (leave empty)
OPENAI_API_KEY=your-api-key-here

# Model ID to use by default
# Examples:
#   - LM Studio: mistral, neural-chat, etc.
#   - OpenAI: gpt-4, gpt-3.5-turbo
#   - Ollama: mistral, llama2, etc.
#   - Dashscope: qwen-turbo, qwen-plus, etc.
OPENAI_MODEL=your-model-id

# API request timeout in seconds (default: 240)
API_TIMEOUT=240

# Directory to save JSON reports (default: reports)
REPORT_DIR=reports
